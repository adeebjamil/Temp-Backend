# ═══════════════════════════════════════════════
# W-Mail Backend — Environment Variables
# Copy this file to .env and fill in real values
# ═══════════════════════════════════════════════

# TestMail.app Configuration
TESTMAIL_NAMESPACE=your_namespace
TESTMAIL_API_KEY=your_testmail_api_key

# MongoDB Connection (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/wmail

# JWT Secret — MUST be a strong random string (64+ chars recommended)
JWT_SECRET=generate_a_strong_random_secret_here

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Admin Email — the Google account email that gets SUPERADMIN role
ADMIN_EMAIL=your_admin_email@gmail.com

# Server Port
PORT=5000
